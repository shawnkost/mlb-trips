# Copy to .env.local. Defaults match the local docker-compose.yml Postgres.
# Pooled connection used by the app at runtime.
DATABASE_URL=postgres://mlb:mlb@localhost:5432/mlb_trips
# Direct (non-pooled) connection used only by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=postgres://mlb:mlb@localhost:5432/mlb_trips
